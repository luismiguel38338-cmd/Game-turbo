#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ADMIN_DIR="$(dirname "$SCRIPT_PATH")"
ROOT_DIR="$(dirname "$ADMIN_DIR")"
CONF_FILE="$ADMIN_DIR/config/gameturbo.conf"
LOG_DIR="$ADMIN_DIR/logs"
LOG_FILE="$LOG_DIR/admin.log"

mkdir -p "$LOG_DIR"

if [[ -f "$CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONF_FILE"
fi

log_event() {
  local level="$1"
  local msg="$2"
  printf '%s [%s] %s\n' "$(date -Iseconds)" "$level" "$msg" >> "$LOG_FILE"
}

validate_safe_name() {
  local val="$1"
  if [[ ! "$val" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "Error: nombre inválido '$val'. Solo se permiten caracteres alfanuméricos, '.', '_' y '-'." >&2
    exit 1
  fi
}

cmd_help() {
  cat <<'EOF'
GAME TURBO AI — Consola Privada de Administración Termux (gameturbo-admin)
Uso: gameturbo-admin <comando> [argumentos]

Comandos disponibles:
  help                Muestra esta ayuda
  status              Consulta el estado del proyecto, configuración y últimas compilaciones
  modules             Lista los módulos Kotlin y extensiones administrativas locales
  verify              Verifica la integridad de archivos, manifiesto y ausencia de IA
  build [debug|rel]   Prepara y ejecuta la compilación del APK (por defecto: debug)
  update              Actualiza permisos de scripts y verifica dependencias locales
  backup              Crea una copia de seguridad comprimida con suma SHA-256
  logs                Muestra los registros de operaciones de gameturbo-admin
  config [k] [v]      Consulta o modifica de forma segura parámetros permitidos en gameturbo.conf
  add-tool <nombre>   Crea una plantilla de herramienta administrativa en modules/
EOF
}

cmd_status() {
  log_event "INFO" "Consulta de estado del proyecto"
  echo "=== GAME TURBO AI — ESTADO DEL PROYECTO ==="
  echo "Directorio raíz : $ROOT_DIR"
  echo "Aplicación      : ${APP_NAME:-Game Turbo AI} v${APP_VERSION:-1.0.0}"
  echo "Muestreo base   : ${DEFAULT_SAMPLING_INTERVAL_MS:-3000} ms"
  echo "Variante build  : ${BUILD_VARIANT:-debug}"
  local debug_apk="$ROOT_DIR/app/build/outputs/apk/debug/app-debug.apk"
  if [[ -f "$debug_apk" ]]; then
    echo "APK Debug       : PRESENTE ($(du -h "$debug_apk" | cut -f1))"
    sha256sum "$debug_apk"
  else
    echo "APK Debug       : No compilado aún"
  fi
}

cmd_modules() {
  log_event "INFO" "Listado de módulos"
  echo "=== MÓDULOS ANDROID (com/gameturbo/ai) ==="
  find "$ROOT_DIR/app/src/main/java/com/gameturbo/ai" -maxdepth 1 -mindepth 1 -type d | sort | xargs -n1 basename
  echo ""
  echo "=== MÓDULOS TERMUX (gameturbo-admin/modules) ==="
  for mod in "$ADMIN_DIR/modules/"*.module.sh; do
    [[ -f "$mod" ]] || continue
    # shellcheck disable=SC1090
    source "$mod"
    echo "• $(basename "$mod")"
  done
  declare -F module_telemetry_info >/dev/null && module_telemetry_info || true
  declare -F module_security_info >/dev/null && module_security_info || true
}

cmd_verify() {
  log_event "INFO" "Verificación de integridad ejecutada"
  bash "$ADMIN_DIR/scripts/verify.sh"
}

cmd_build() {
  local variant="${1:-debug}"
  if [[ "$variant" == "rel" ]]; then variant="release"; fi
  log_event "INFO" "Inicio de compilación ($variant)"
  bash "$ADMIN_DIR/scripts/build.sh" "$variant"
  log_event "INFO" "Compilación finalizada ($variant)"
}

cmd_update() {
  log_event "INFO" "Actualización de componentes locales"
  chmod +x "$ADMIN_DIR/gameturbo-admin" "$ADMIN_DIR/scripts/"*.sh
  echo "[update] Permisos de scripts actualizados."
  if command -v gradle >/dev/null 2>&1; then
    echo "[update] Gradle disponible: $(gradle --version | head -n 3 | tr '\n' ' ')"
  else
    echo "[update] Gradle no encontrado en PATH; se usará ./gradlew si existe."
  fi
}

cmd_backup() {
  log_event "INFO" "Copia de seguridad solicitada"
  bash "$ADMIN_DIR/scripts/backup.sh"
}

cmd_logs() {
  if [[ -f "$LOG_FILE" ]]; then
    tail -n 50 "$LOG_FILE"
  else
    echo "No hay registros en $LOG_FILE todavía."
  fi
}

cmd_config() {
  local key="${1:-}"
  local val="${2:-}"
  if [[ -z "$key" ]]; then
    cat "$CONF_FILE"
    return 0
  fi
  case "$key" in
    DEFAULT_SAMPLING_INTERVAL_MS|BUILD_VARIANT|BACKUP_RETENTION_COUNT|LOG_LEVEL)
      if [[ -z "$val" ]]; then
        grep "^${key}=" "$CONF_FILE" || true
      else
        validate_safe_name "$val"
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$CONF_FILE"
        log_event "CONFIG" "Actualizado $key=$val"
        echo "[config] $key actualizado a '$val'."
      fi
      ;;
    *)
      echo "Error: clave '$key' no permitida para edición." >&2
      exit 1
      ;;
  esac
}

cmd_add_tool() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Uso: gameturbo-admin add-tool <nombre_modulo>" >&2
    exit 1
  fi
  validate_safe_name "$name"
  local dest="$ADMIN_DIR/modules/${name}.module.sh"
  if [[ -e "$dest" ]]; then
    echo "Error: el módulo '$name' ya existe." >&2
    exit 1
  fi
  cat > "$dest" <<EOF
#!/usr/bin/env bash
# Herramienta administrativa local: $name
module_${name}_info() {
  echo "  [$name] Módulo personalizado listo."
}
EOF
  chmod +x "$dest"
  log_event "MODULE" "Añadido módulo local $name"
  echo "[add-tool] Módulo creado en $dest"
}

SUBCOMMAND="${1:-help}"
shift || true

case "$SUBCOMMAND" in
  help|-h|--help) cmd_help ;;
  status) cmd_status ;;
  modules) cmd_modules ;;
  verify) cmd_verify ;;
  build) cmd_build "$@" ;;
  update) cmd_update ;;
  backup) cmd_backup ;;
  logs) cmd_logs ;;
  config) cmd_config "$@" ;;
  add-tool) cmd_add_tool "$@" ;;
  *)
    echo "Comando desconocido: '$SUBCOMMAND'. Ejecuta 'gameturbo-admin help'." >&2
    exit 1
    ;;
esac
